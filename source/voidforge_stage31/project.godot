[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Grid"
3d_physics/layer_4="Interactable"
3d_physics/layer_5="Projectile"
3d_physics/layer_6="Debris"
3d_physics/layer_7="Mineable"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/default_gravity=9.8
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
occlusion_culling/use_occlusion_culling=true
textures/default_filters/use_nearest_mipmap_filter=false
