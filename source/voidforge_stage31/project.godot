; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Voidforge"
config/description="Original mobile-first 3D engineering, exploration, mining, and survival sandbox."
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.015, 0.02, 0.028, 1)

[autoload]

GameConfig="*res://scripts/core/game_config.gd"
DebugLog="*res://scripts/core/debug_log.gd"
ItemDB="*res://scripts/inventory/item_database.gd"
GridDB="*res://scripts/grids/grid_registry.gd"
BlockDB="*res://scripts/blocks/block_database.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true
window/frame_pacing/android/enable_frame_pacing=true

